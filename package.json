{
  "name": "@hanzo/theming",
  "version": "7.3.2",
  "description": "Theme engine, palette generation, and themed components for Hanzo-powered apps",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./css": {
      "types": "./css/index.d.ts",
      "import": "./css/index.js"
    },
    "./semantic.css": "./css/semantic.css",
    "./gui": {
      "types": "./gui/index.d.ts",
      "import": "./gui/index.js"
    },
    "./gui/components": {
      "types": "./gui/components/index.d.ts",
      "import": "./gui/components/index.js"
    },
    "./gui/defaults": {
      "types": "./gui/defaults/index.d.ts",
      "import": "./gui/defaults/index.js"
    }
  },
  "bin": {
    "generate-palettes": "./css/generate-palettes.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc && node scripts/prepare-dist.mjs",
    "pub": "./scripts/publish.sh"
  },
  "peerDependencies": {
    "@hanzo/gui": ">=8.3.0",
    "@hanzogui/shorthands": "8.3.1",
    "@hanzogui/theme-builder": "8.3.1",
    "@hanzogui/web": "8.3.1",
    "react": ">=19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "typescript": "7.0.2"
  },
  "author": "Hanzo AI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzoai/theming"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.24.0"
}
