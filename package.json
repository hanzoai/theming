{
  "name": "@hanzo/theming",
  "version": "7.3.1",
  "description": "Theme engine, palette generation, and themed components for Hanzo-powered apps",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./css": {
      "types": "./css/index.d.ts",
      "import": "./css/index.js"
    },
    "./semantic.css": "./css/semantic.css",
    "./gui": {
      "types": "./gui/index.d.ts",
      "import": "./gui/index.js"
    },
    "./gui/components": {
      "types": "./gui/components/index.d.ts",
      "import": "./gui/components/index.js"
    },
    "./gui/defaults": {
      "types": "./gui/defaults/index.d.ts",
      "import": "./gui/defaults/index.js"
    }
  },
  "bin": {
    "generate-palettes": "./css/generate-palettes.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "build": "rm -rf dist && tsgo && node scripts/prepare-dist.mjs",
    "pub": "./scripts/publish.sh"
  },
  "peerDependencies": {
    "@hanzo/gui": "^8.0.1",
    "@hanzogui/shorthands": "^8.0.0",
    "@hanzogui/theme-builder": "^8.0.0",
    "@hanzogui/web": "^8.0.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.4",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "typescript": "^5.9.3"
  },
  "author": "Hanzo AI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzoai/theming"
  },
  "publishConfig": {
    "access": "public"
  }
}
